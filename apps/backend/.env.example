# Backend Environment Variables Template
# Copy this file to .env and fill in the values

# ========== DATABASE (Supabase PostgreSQL) ==========
# Supabase Project: ekhsfnqethzavutooenz
# Host: aws-1-ap-southeast-2.pooler.supabase.com
# Port: 6543
# Database: postgres
# User: postgres.ekhsfnqethzavutooenz
# Replace [YOUR-PASSWORD] with your Supabase database password
DATABASE_URL=postgresql://postgres.ekhsfnqethzavutooenz:[YOUR-PASSWORD]@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres

# ========== APP ==========
APP_URL=http://localhost:3000
API_URL=http://localhost:8080
NODE_ENV=development
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# ========== FLUTTERWAVE ==========
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_ENCRYPTION_KEY=FLWSECK_TESTexxxxxxxxxxxxxxxxxxxxxxxx
FLUTTERWAVE_WEBHOOK_SECRET=your-webhook-secret-here

# ========== CONFLUX (TESTNET) ==========
CONFLUX_RPC_URL=https://evmtestnet.confluxrpc.com
CONFLUX_CHAIN_ID=71

# Hot Wallet (Deployer)
HOT_WALLET_PRIVATE_KEY=0xyour-private-key-here

# Admin Signers
ADMIN_SIGNER_1=0x...
ADMIN_SIGNER_2=0x...
ADMIN_SIGNER_3=0x...

# ========== TOKEN CONTRACTS (TESTNET) ==========
AXCNH_CONTRACT_ADDRESS=0x...
AXCNH_VAULT_ADDRESS=0x...

# ========== STAKING ==========
STAKING_CONTRACT_ADDRESS=0x...

# ========== WEB3AUTH (Optional) ==========
